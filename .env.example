# FastAPI
DATABASE_URL=
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Brasaland RAG knowledge base (keep actual credentials in ignored .env.local)
QDRANT_URL=http://localhost:6333
RAG_COLLECTION=brasaland_knowledge
LLM_API_KEY=
LLM_BASE_URL=https://llm.4geeks.ai
RAG_EMBEDDING_MODEL=madrid-spain/openrouter/perplexity/pplx-embed-v1-0.6b
RAG_GENERATION_MODEL=madrid-spain/openrouter/deepseek/deepseek-v4-flash
RAG_MIN_SCORE=0.45
# Base URL of the existing FastAPI incidents service (GET /api/incidents...)
INCIDENTS_API_URL=http://127.0.0.1:8000

# Remote Brasaland MCP server (OAuth 2.1/OIDC resource server)
# Use the public externally reachable HTTPS URL in production; include /mcp in resource URL.
MCP_PUBLIC_URL=http://localhost:8300
MCP_RESOURCE_URL=http://localhost:8300/mcp
MCP_OAUTH_ISSUER=
MCP_OAUTH_TYPE=oidc
INCIDENTS_API_BASE_URL=http://api:8000
# OAuth access token issued by the configured provider for the agent's own service identity.
# Required scopes: mcp:access plus the tool-specific scope used by the agent.
MCP_AGENT_ACCESS_TOKEN=

# Next.js
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only Supabase access for Vercel API functions.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated Supabase Auth UUID allowlist for staff intake access.
CRM_STAFF_USER_IDS=

# Local ordering API override. Production defaults to https://api.brasaland.site/api.
ORDERING_API_URL=http://127.0.0.1:8000/api
GOOGLE_GEOCODING_API_KEY=

# ERP Vercel app URL used in staff account and password reset emails.
ERP_PUBLIC_URL=https://erp.brasaland.site
