// ==========================================================
// SCHEMA CENTRAL - Plataforma de gestión de restaurantes
// Locales, usuarios/roles/permisos, inventario, pedidos/clientes,
// RRHH, recetas de cocina, menú/pedido online y ventas para BI.
// ==========================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -----------------------------
// LOCALES
// -----------------------------

model Location {
  id        String   @id @default(uuid())
  name      String
  city      String
  country   String
  currency  String
  timezone  String?
  createdAt DateTime @default(now())

  users        User[]
  suppliers    Supplier[]
  inventory    InventoryItem[]
  purchases    Purchase[]
  orders       Order[]
  recipes      Recipe[]
  shifts       Shift[]
  timeOffs     TimeOff[]
  serviceStats ServiceStat[]
  menuItems    MenuItem[]
  reservations Reservation[]

  brasapointsRules BrasapointsRule[]
}

// -----------------------------
// USUARIOS Y ROLES / PERMISOS (RBAC)
// -----------------------------
enum ModuleName {
  INVENTORY
  CRM
  HR
  KITCHEN
  BI
  ADMIN
  ORDERS
}

enum PermissionAction {
  READ
  WRITE
}

model Role {
  id          String  @id @default(uuid())
  key         String  @unique
  name        String
  description String?

  users       User[]
  permissions RolePermission[]
}

model RolePermission {
  id     String           @id @default(uuid())
  roleId String
  module ModuleName
  action PermissionAction
  role   Role             @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, module, action])
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  name         String
  active       Boolean   @default(true)
  roleId       String
  role         Role      @relation(fields: [roleId], references: [id])
  locationId   String?
  location     Location? @relation(fields: [locationId], references: [id])
  createdAt    DateTime  @default(now())
}

// -----------------------------
// INVENTARIO / COMPRAS / PROVEEDORES
// -----------------------------
model Supplier {
  id         String   @id @default(uuid())
  name       String
  contact    String?
  locationId String
  location   Location @relation(fields: [locationId], references: [id])

  items     InventoryItem[]
  purchases Purchase[]
}

model InventoryItem {
  id           String   @id @default(uuid())
  name         String
  category     String   @default("Otros") // ej. "Carnes", "Verduras", "Bebidas", "Otros"
  unit         String
  currentStock Float    @default(0)
  minStock     Float    @default(0)
  price        Float
  currency     String
  supplierId   String
  supplier     Supplier @relation(fields: [supplierId], references: [id])
  locationId   String
  location     Location @relation(fields: [locationId], references: [id])
  updatedAt    DateTime @updatedAt

  @@index([locationId])
}

model Purchase {
  id         String   @id @default(uuid())
  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id])
  locationId String
  location   Location @relation(fields: [locationId], references: [id])
  itemName   String
  quantity   Float
  unitPrice  Float
  currency   String
  createdAt  DateTime @default(now())
}

// -----------------------------
// PEDIDOS / CLIENTES
// -----------------------------
model Customer {
  id          String   @id @default(uuid())
  name        String
  email       String?
  authUserId  String?  @unique
  phone       String?
  country     String?
  city        String?
  preferences String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  orders             Order[]
  reservations       Reservation[]
  brasapointsAccount BrasapointsAccount?
  feedback           CustomerFeedback[]

  @@index([email])
  @@index([phone])
}

model Reservation {
  id                  String   @id @default(uuid())
  customerId          String   @map("customer_id")
  customer            Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  firstName           String   @map("first_name")
  lastName            String   @map("last_name")
  email               String
  phone               String
  country             String
  city                String
  partySize           Int      @map("party_size")
  reservationDate     DateTime @db.Date @map("reservation_date")
  reservationTime     DateTime @db.Time(0) @map("reservation_time")
  locationPreference  String?  @map("location_preference")
  notes               String?
  referralSource      String?  @map("referral_source")
  status              String   @default("NEW")
  source              String   @default("ONLINE")
  locationId          String?  @map("location_id")
  createdBy           String?  @map("created_by")
  createdAt           DateTime @default(now()) @db.Timestamptz(6) @map("created_at")
  location            Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)
  orders              Order[]

  @@index([createdAt])
  @@index([customerId, reservationDate])
  @@index([locationId, reservationDate])
  @@map("reservations")
}

model CandidateApplication {
  id               String   @id @default(uuid())
  fullName         String   @map("full_name")
  email            String
  phone            String
  position         String
  linkedinUrl      String?  @map("linkedin_url")
  experienceYears  Int      @default(0) @map("experience_years")
  cvPath           String   @map("cv_path")
  cvFilename       String   @map("cv_filename")
  status           String   @default("RECEIVED")
  createdAt        DateTime @default(now()) @db.Timestamptz(6) @map("created_at")

  @@index([createdAt])
  @@map("candidate_applications")
}

enum OrderStatus {
  RECEIVED
  PREPARING
  READY
  COMPLETED
  CANCELLED
}

enum OrderSource {
  ONLINE
  POS
  COUNTER
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  NOT_APPLICABLE
}

model Order {
  id String @id @default(uuid())

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])

  locationId String
  location   Location @relation(fields: [locationId], references: [id])

  items OrderItem[]
  reservationId String? @unique
  reservation   Reservation? @relation(fields: [reservationId], references: [id], onDelete: SetNull)
  guestCount    Int?
  feedback      CustomerFeedback?

  // -----------------------------
  // PRECIOS
  // -----------------------------
  currency String

  subtotal Float
  discount Float @default(0)
  total    Float

  // -----------------------------
  // BRASAPOINTS
  // -----------------------------
  brasapointsDiscount Float @default(0)
  brasapointsUsed     Int   @default(0)
  brasapointsEarned   Int   @default(0)

  brasapointsTransactions BrasapointsTransaction[]

  // -----------------------------
  // PEDIDO
  // -----------------------------
  status          OrderStatus @default(RECEIVED)
  source          OrderSource @default(ONLINE)
  fulfillment     String      @default("pickup")
  deliveryAddress String?
  customerNotes   String?

  // -----------------------------
  // PAGO
  // -----------------------------
  paymentStatus         PaymentStatus @default(PENDING)
  paymentPreference     String?
  stripeSessionId       String?       @unique
  stripePaymentIntentId String?

  // -----------------------------
  // FECHAS
  // -----------------------------
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([locationId, status])
  @@index([customerId, createdAt])
  @@index([reservationId])
}

model CustomerFeedback {
  id                    String   @id @default(uuid()) @db.Uuid
  customerId            String   @map("customer_id")
  orderId               String   @unique @map("order_id")
  valueForMoneyRating   Int      @map("value_for_money_rating") @db.SmallInt
  comment               String   @default("")
  createdAt             DateTime @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt             DateTime @default(now()) @db.Timestamptz(6) @map("updated_at")
  customer              Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  order                 Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@map("customer_feedback")
}

model OrderItem {
  id      String @id @default(uuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  dishName  String
  quantity  Int
  unitPrice Float
  subtotal  Float

  menuItemId String?
}

model MenuItem {
  id          String   @id @default(uuid())
  name        String
  nameEn      String?
  description String?
  category    String
  price       Float
  currency    String
  imageUrl    String?
  available   Boolean  @default(true)
  locationId  String
  location    Location @relation(fields: [locationId], references: [id])
  updatedAt   DateTime @updatedAt

  @@index([locationId, available])
}

// -----------------------------
// BRASAPOINTS
// -----------------------------

enum BrasapointsTransactionType {
  WELCOME
  ORDER_REWARD
  REDEMPTION
  MANUAL_ADJUSTMENT
}

model BrasapointsAccount {
  id         String   @id @default(uuid())
  customerId String   @unique
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  balance Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions BrasapointsTransaction[]
}

model BrasapointsTransaction {
  id        String             @id @default(uuid())
  accountId String
  account   BrasapointsAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  type   BrasapointsTransactionType
  points Int

  orderId String?
  order   Order?  @relation(fields: [orderId], references: [id])

  description String?
  createdAt   DateTime @default(now())

  @@index([accountId, createdAt])
  @@index([orderId])
}

model BrasapointsRule {
  id String @id @default(uuid())

  locationId String
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  minimumOrderAmount Float?
  points             Int
  pointValue         Float

  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([locationId, active])
}

// -----------------------------
// RRHH
// -----------------------------
model Employee {
  id       String  @id @default(uuid())
  name     String
  position String
  email    String  @unique
  active   Boolean @default(true)

  timeOffs TimeOff[]
  shifts   Shift[]
}

model TimeOff {
  id         String   @id @default(uuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])
  locationId String
  location   Location @relation(fields: [locationId], references: [id])
  type       String
  startDate  DateTime
  endDate    DateTime
  approved   Boolean  @default(false)
}

model Shift {
  id         String   @id @default(uuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])
  locationId String
  location   Location @relation(fields: [locationId], references: [id])
  startTime  DateTime
  endTime    DateTime
}

model ServiceStat {
  id               String   @id @default(uuid())
  locationId       String
  location         Location @relation(fields: [locationId], references: [id])
  date             DateTime
  noShows          Int      @default(0)
  reservations     Int      @default(0)
  tableTurnoverMin Float?
  avgMealTimeMin   Float?
}

// -----------------------------
// COCINA
// -----------------------------
model Recipe {
  id             String    @id @default(uuid())
  nameEs         String
  nameEn         String
  instructionsEs String
  instructionsEn String
  rulesEs        String?
  rulesEn        String?
  locationId     String?
  location       Location? @relation(fields: [locationId], references: [id])
  updatedAt      DateTime  @updatedAt
}
