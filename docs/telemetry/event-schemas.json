{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://brasaland.example/schemas/telemetry/event-schemas.json",
  "title": "Brasaland Telemetry Event",
  "description": "Standard event envelope and strict per-event payload allowlists. This is a design contract, not proof that events are instrumented.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "eventId",
    "timestamp",
    "sessionId",
    "userId",
    "event_type",
    "schemaVersion",
    "requestId",
    "properties"
  ],
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "sessionId": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 128
    },
    "userId": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 128
    },
    "event_type": {
      "type": "string",
      "enum": [
        "inbound_order_created",
        "outbound_order_created",
        "stock_waste_registered",
        "stock_threshold_triggered",
        "direct_stock_edit_rejected",
        "ingredient_price_variance_detected",
        "inbound_order_validation_failed",
        "outbound_order_validation_failed",
        "inventory_order_submitted",
        "inventory_flow_abandoned",
        "minimum_stock_alert_acknowledged",
        "supplier_delivery_recorded",
        "supplier_price_updated",
        "inventory_threshold_configuration_changed",
        "login_succeeded",
        "login_failed",
        "session_expired",
        "permission_denied",
        "api_request_completed",
        "api_request_failed",
        "database_operation_slow",
        "frontend_action_failed",
        "frontend_route_viewed",
        "frontend_flow_step_completed",
        "frontend_flow_abandoned",
        "telemetry_event_dropped",
        "telemetry_schema_validation_failed"
      ]
    },
    "schemaVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "requestId": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 128
    },
    "properties": {
      "type": "object"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "inbound_order_created"
          }
        }
      },
      "then": {
        "properties": {
          "properties": {
            "$ref": "#/$defs/payload_inbound_order_created"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "outbound_order_created"
          }
        }
      },
      "then": {
        "properties": {
