  "$defs": {
    "payload_inbound_order_created": {
      "title": "inbound_order_created properties",
      "description": "Mandatory: confirmed inbound delivery, supporting purchasing analysis.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "location_id",
        "country",
        "product_id",
        "product_category",
        "quantity",
        "unit",
        "currency",
        "supplier_id",
        "order_id",
        "unit_cost",
        "total_cost"
      ],
      "properties": {
        "location_id": {
          "type": "string"
        },
        "country": {
          "type": "string",
          "enum": [
            "CO",
            "US"
          ]
        },
        "product_id": {
          "type": "string",
          "maxLength": 128
        },
        "product_category": {
          "type": "string",
          "enum": [
            "protein",
            "vegetable",
            "sauce",
            "beverage",
            "packaging",
            "cleaning"
          ]
        },
        "quantity": {
          "type": "number"
        },
        "unit": {
          "type": "string",
          "enum": [
            "kg",
            "g",
            "unit",
            "liter",
            "ml",
            "box",
            "pack"
          ]
        },
        "currency": {
          "type": "string",
          "enum": [
            "COP",
            "USD"
          ]
        },
        "supplier_id": {
          "type": "string"
        },
        "order_id": {
          "type": "string"
        },
        "unit_cost": {
          "type": "number",
          "minimum": 0
        },
        "total_cost": {
          "type": "number",
          "minimum": 0
        }
      }
    },
